{
  "$comment": [
    "beetle repo manifest — machine-local, never committed to any repo.",
    "Lives at $BEETLE_REPOS, else $XDG_CONFIG_HOME/beetle/repos.json, else ~/.config/beetle/repos.json.",
    "Set BEETLE_REPOS in .claude/settings.local.json (gitignored) to relocate per machine.",
    "'path' supports ~ and $ENV expansion. 'url' should be the GitHub URL so courier summaries stay portable.",
    "Mirrors the portable mcp.json artifact pattern from aichat integrated-architecture docs."
  ],
  "repos": [
    {
      "name": "aichat",
      "path": "~/Developer/Projects/aichat",
      "url": "https://github.com/jikanter/aichat-private",
      "role": "runtime"
    },
    {
      "name": "brief",
      "path": "~/Developer/Projects/brief",
      "url": "https://github.com/jikanter/brief",
      "role": "compiler"
    },
    {
      "name": "llm-functions",
      "path": "/Volumes/ExternalData/admin/Developer/Scripts/llm-functions",
      "url": "https://github.com/jikanter/personal-llm-functions",
      "role": "tools"
    },
    {
      "name": "astrophage",
      "path": "~/Developer/Projects/astrophage",
      "url": "https://github.com/jikanter/astrophage",
      "role": "replay-cache"
    }
  ],
 "meta_repo": "https://github.com/jikanter/eridian-agents"
}